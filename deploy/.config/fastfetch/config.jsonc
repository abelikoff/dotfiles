// IBM mainframe-style fastfetch output

// (with some inspiration from https://neil.computer/notes/neofetch/ )

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "none",
  },

  "display": {
    "separator": "\t",
    "color": {
      "keys": "blue",
      "output": "green",
    },
    "bar": {
      "width": 20,
      "border": {
        "left": "[",
        "right": "]",
      },
      "char": {
        "elapsed": "█",
        "total": "░",
      },
      // Flat keys for older fastfetch (e.g. 2.40), which ignores the nested
      // "border"/"char" objects above and falls back to "[ ■ ■ --- ]".
      "borderLeft": "[",
      "borderRight": "]",
      "charElapsed": "█",
      "charTotal": "░",
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "green",
        "yellow": "yellow",
        "red": "red",
      },
    },
  },

  "modules": [
    "break",

    // Header sized to the terminal width (min 80 columns): uppercased
    // hostname and "SYSTEM STATUS" centered, then a full-width rule.
    // The leading \r moves past the module's key/separator to column 0.
    {
      "type": "command",
      "key": " ",
      "shell": "sh",
      "text": "W=$(stty size </dev/tty 2>/dev/null | cut -d' ' -f2); [ \"${W:-0}\" -ge 80 ] 2>/dev/null || W=80; HOST=$(hostname | tr '[:lower:]' '[:upper:]'); T='SYSTEM STATUS'; printf '\\r\\033[0;37m%*s\\n' $(( (W + ${#HOST}) / 2 )) \"$HOST\"; printf '\\033[1;34m%*s\\n' $(( (W + ${#T}) / 2 )) \"$T\"; printf '%*s' $W '' | sed 's/ /─/g'",
    },

    {
      "type": "title",
      "key": "\t User\t",
      "format": "{#31}{user-name}@{host-name}{#}",
    },

    "break",

    { "type": "cpu", "key": "\t CPU\t" },
    { "type": "gpu", "key": "\t GPU\t" },
    { "type": "os", "key": "\t OS\t" },
    { "type": "kernel", "key": "\t Kernel\t", "format": "{sysname} {release}" },
    { "type": "packages", "key": "\t Packages" },
    { "type": "localip", "key": "\t Local IP" },
    { "type": "uptime", "key": "\t Uptime\t" },

    "break",

    { "type": "cpuusage", "key": "\t CPU Usage" },
    { "type": "memory", "key": "\t Memory\t" },

    {
      "type": "disk",
      "key": "\t Disk\t",
      "folders": "/",
      "format": "{size-percentage-bar} {size-used} / {size-total} ({size-percentage})",
    },

    "break",
  ],
}
